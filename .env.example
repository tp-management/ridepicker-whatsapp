# RidePicker backend configuration.
# Runtime state is Supabase-only. Do not configure local auth/data directories
# or persistent filesystem storage for WhatsApp/Baileys state.

PORT=3001
N8N_WEBHOOK_URL=
# If true, user-authored outgoing text/caption messages also enter the n8n outbox.
# RidePicker /send replies are excluded to avoid AI response loops.
# Defaults to false. Enabling this sends ALL manual outbound conversations to n8n.
N8N_FORWARD_FROM_ME=false
N8N_FORWARD_SESSION_EVENTS=false
N8N_FORWARD_MEDIA_WITHOUT_TEXT=false

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

FRONTEND_ORIGINS=https://ride-picker.web.app,http://localhost:5173
INTERNAL_API_KEY=
SESSION_POLICY_CACHE_MS=5000
